APP_NAME=RouteIQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=routeiq
DB_USERNAME=root
DB_PASSWORD=

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=routeiq_cache_

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_PREFIX=routeiq_

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@routeiq.com
MAIL_FROM_NAME=RouteIQ

# AWS Configuration (if using S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_SECRET=your-secret-key-change-this
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Maps Configuration
# Options: 'fake' (for testing with deterministic results) or 'google' (production)
MAPS_PROVIDER=fake
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_TIMEOUT=10

# Route Cache Configuration
# TTL in seconds for cached route calculations (default: 86400 = 24 hours)
ROUTE_CACHE_TTL=86400

# Cost Calculation Cache & Config
# TTL for cost result caching (default: 3600 = 1 hour)
COST_CACHE_TTL=3600
# TTL for config reads from cache (default: 300 = 5 minutes)
COST_CONFIG_CACHE_TTL=300
# Currency display (default: INR)
CURRENCY=INR

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# API Configuration
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=60

# Cost Configuration (Pricing Parameters)
CAR_FUEL_EFFICIENCY_KM_PER_L=15
CAR_FUEL_PRICE_PER_L=95
CAR_DRIVER_COST_PER_KM=10
CAR_TOLL_MULTIPLIER=0.05
CAR_TAX_PERCENTAGE=5

EV_KWH_PER_KM=0.2
EV_PRICE_PER_KWH=15
EV_CHARGING_LOSS=1.1
EV_BATTERY_DEGRADATION_PER_KM=0.5
EV_MAINTENANCE_PER_KM=0.2

TRAIN_BASE_FARE=100
TRAIN_FARE_PER_KM=2
TRAIN_DISCOUNT_200KM=1.5
TRAIN_DISCOUNT_500KM=1.2

FLIGHT_AIRPORT_FEE=200
FLIGHT_COST_PER_KM=2.5
FLIGHT_TAX=500
FLIGHT_FUEL_SURCHARGE_PERCENTAGE=10

# Feature Flags
FEATURE_POI_NEARBY=true
FEATURE_TSP_OPTIMIZATION=true
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_ANALYTICS=true
FEATURE_CACHING=true

# Monitoring
SENTRY_LARAVEL_DSN=

# Sanctum Configuration (if using API tokens)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000
